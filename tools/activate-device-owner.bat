@echo off
chcp 65001 > nul
title শুদ্ধ গার্ড (Shuddho Guard) — ডিভাইস ওনার সক্রিয়করণ টুল

echo ===================================================================
echo        🛡️ শুদ্ধ গার্ড: অপ্রতিরোধ্য সুরক্ষা সক্রিয়করণ টুল
echo ===================================================================
echo.
echo ১. আপনার ফোনের Developer Options থেকে USB Debugging চালু করুন।
echo ২. ইউএসবি ক্যাবল দিয়ে মোবাইলটি কম্পিউটারের সাথে যুক্ত করুন।
echo.
pause

echo.
echo ফোনটি শনাক্ত করা হচ্ছে...
adb devices
echo.

echo শুদ্ধ গার্ডকে ডিভাইসের চূড়ান্ত ওনার (Device Owner) হিসেবে ঘোষণা করা হচ্ছে...
adb shell dpm set-device-owner com.shuddho.guard/.receivers.ShuddhoDeviceAdminReceiver

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ===================================================================
    echo [অভিনন্দন!] শুদ্ধ গার্ড এখন ডিভাইসের পূর্ণ ওনার হিসেবে লক হয়ে গেছে।
    echo এখন ফোন ফ্ল্যাশ দেওয়া ছাড়া এই অ্যাপ কেউ আন-ইনস্টল করতে পারবে না!
    echo ===================================================================
) else (
    echo.
    echo [ত্রুটি!] ডিভাইস ওনার সক্রিয় হয়নি। ফোনে কোনো গুগল অ্যাকাউন্ট থাকলে সাময়িকভাবে রিমুভ করে আবার চেষ্টা করুন।
)

echo.
pause
